# Docs stay local. Only progress.md (conflict board) and README.md (submission) go to GitHub.
*.md
!progress.md
!README.md
# shared contracts are meant to be on GitHub
!contracts/*.md

# Research bundle, raw data, models
DATATHON INFO/
/data/
*.csv
# NNPA on/off timing is evidence, small and ours
!evidence/nnpa_timing.csv
*.zip
*.gguf
*.img
*.npz
*.keras
*.h5

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
# a public key, published so anyone can check the signer's signatures
!contracts/signer_pub.pem
id_*

# Tooling
.claude/
__pycache__/
*.pyc
.venv/
node_modules/
dist/
.ipynb_checkpoints/

# Local secrets and test artefacts
secrets/
.coverage
htmlcov/
.pytest_cache/

# API keys and other secret text files
*apikey*
*.key.txt

# docs bundles for teammates (sent on Discord/Drive, never committed)
share/

# superseded docs, kept locally for reference (never shared or committed)
_archive/

# the public-alert relay remembers what it has sent
alerting/.sent
